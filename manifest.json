{
  "manifest_version": 3,
  "name": "VSOL Scout",
  "description": "Экспорт данных матча ВСОЛ",
  "version": "0.1.0",

  "permissions": [
    "activeTab",
    "downloads"
  ],

  "host_permissions": [
    "https://www.virtualsoccer.ru/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.virtualsoccer.ru/mng_order.php*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "VSOL Scout"
  }
}