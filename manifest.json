{
  "manifest_version": 3,
  "name": "VSOL Scout",
  "version": "0.1.2",
  "description": "Разведка и сбор данных матчей ВСОЛ",

  "permissions": [
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "https://www.virtualsoccer.ru/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.virtualsoccer.ru/mng_order.php*",
        "https://www.virtualsoccer.ru/roster.php*",
        "https://www.virtualsoccer.ru/mng_*.php*",
        "https://www.virtualsoccer.ru/match.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.virtualsoccer.ru/mng_order.php*",
        "https://www.virtualsoccer.ru/roster.php*",
        "https://www.virtualsoccer.ru/mng_*.php*",
        "https://www.virtualsoccer.ru/match.php*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "action": {
    "default_title": "VSOL Scout",
    "default_popup": "popup.html"
  }
}
